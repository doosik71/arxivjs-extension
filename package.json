{
  "name": "arxivjs-viewer",
  "displayName": "ArxivJS VSCode Extension",
  "description": "Browse papers in an arxivjs data folder from VS Code.",
  "version": "0.3.1",
  "publisher": "doosik71",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/doosik71/arxivjs-extension.git"
  },
  "homepage": "https://github.com/doosik71/arxivjs-extension#readme",
  "bugs": {
    "url": "https://github.com/doosik71/arxivjs-extension/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "arxiv",
    "paper",
    "markdown",
    "katex"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "arxivjs",
          "title": "ArxivJS",
          "icon": "media/arxivjs.svg"
        }
      ]
    },
    "views": {
      "arxivjs": [
        {
          "id": "arxivjs.topics",
          "name": "Topics",
          "icon": "media/arxivjs.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "arxivjs.topics",
        "when": "arxivjs.state == noFolder",
        "contents": "No arxivjs data folder is set.\n[Select Data Folder](command:arxivjs.selectDataFolder)\nThe selected path is saved in the arxivjs.dataFolder setting."
      },
      {
        "view": "arxivjs.topics",
        "when": "arxivjs.state == invalidFolder",
        "contents": "Cannot open the data folder.\nCheck that the arxivjs.dataFolder setting is the absolute path of an existing folder.\n[Select Data Folder](command:arxivjs.selectDataFolder)\n[Reload](command:arxivjs.reload)"
      },
      {
        "view": "arxivjs.topics",
        "when": "arxivjs.state == empty",
        "contents": "The data folder has no topic folders.\nTopic folder names may contain only letters, digits, Hangul, spaces, _, (, ), and -.\n[Reload](command:arxivjs.reload)\n[Select Data Folder](command:arxivjs.selectDataFolder)"
      }
    ],
    "configuration": {
      "title": "ArxivJS",
      "properties": {
        "arxivjs.dataFolder": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Absolute path to the arxivjs data folder."
        },
        "arxivjs.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "ko"
          ],
          "enumDescriptions": [
            "Follow the VS Code display language (Korean if it is Korean, otherwise English)",
            "English",
            "Korean (한국어)"
          ],
          "default": "en",
          "markdownDescription": "Display language of the extension's messages, tree, and panels. Reload the window to apply a change. Command titles and setting descriptions are always in English."
        },
        "arxivjs.paperSort": {
          "type": "string",
          "enum": [
            "citation",
            "year",
            "title"
          ],
          "enumDescriptions": [
            "Citation count, descending",
            "Year, descending",
            "Title, ascending"
          ],
          "default": "citation",
          "description": "Sort order of the paper list"
        },
        "arxivjs.openInNewTab": {
          "type": "boolean",
          "default": true,
          "description": "Open a new tab for each paper. If false, reuse a single paper tab."
        },
        "arxivjs.paperPanelLocation": {
          "type": "string",
          "enum": [
            "sameGroup",
            "beside"
          ],
          "enumDescriptions": [
            "Open as a tab in the same editor group as the paper list (Topic panel). The editor is not split.",
            "Open in an editor group beside the paper list, so the list and the paper are visible together."
          ],
          "default": "sameGroup",
          "description": "Editor group in which to open papers"
        },
        "arxivjs.openHomeOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Open the topic list (Home) page when the ArxivJS view is first opened."
        },
        "arxivjs.enableWrite": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable **write support** for the data folder. When on, commands such as adding, renaming, and deleting topics appear, and the extension creates, changes, or deletes files in the data folder. When off, it only reads.\n\n⚠️ Do not edit the same files with the arxivjs app at the same time. The last write wins."
        },
        "arxivjs.llm.engine": {
          "type": "string",
          "enum": [
            "gemini",
            "ollama"
          ],
          "enumDescriptions": [
            "Google Gemini (requires an API key: command \"ArxivJS: Set Gemini API Key\")",
            "Local or remote Ollama server"
          ],
          "default": "gemini",
          "description": "Engine used for AI summaries"
        },
        "arxivjs.gemini.model": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "Gemini model name. The API key is stored in the OS credential store (SecretStorage), not in settings."
        },
        "arxivjs.ollama.url": {
          "type": "string",
          "default": "http://localhost:11434",
          "scope": "machine",
          "description": "Ollama server URL"
        },
        "arxivjs.ollama.model": {
          "type": "string",
          "default": "",
          "description": "Ollama model name (e.g. gemma4:31b)"
        }
      }
    },
    "commands": [
      {
        "command": "arxivjs.createTopic",
        "title": "Add Topic",
        "category": "ArxivJS",
        "icon": "$(add)"
      },
      {
        "command": "arxivjs.renameTopic",
        "title": "Rename Topic",
        "category": "ArxivJS",
        "icon": "$(edit)"
      },
      {
        "command": "arxivjs.deleteTopic",
        "title": "Delete Topic",
        "category": "ArxivJS",
        "icon": "$(trash)"
      },
      {
        "command": "arxivjs.addPaper",
        "title": "Add Paper",
        "category": "ArxivJS",
        "icon": "$(add)"
      },
      {
        "command": "arxivjs.editPaperMeta",
        "title": "Edit Metadata",
        "category": "ArxivJS",
        "icon": "$(edit)"
      },
      {
        "command": "arxivjs.movePaper",
        "title": "Move Paper to Another Topic",
        "category": "ArxivJS",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "arxivjs.deletePaper",
        "title": "Delete Paper",
        "category": "ArxivJS",
        "icon": "$(trash)"
      },
      {
        "command": "arxivjs.deleteSummary",
        "title": "Delete Summary",
        "category": "ArxivJS",
        "icon": "$(trash)"
      },
      {
        "command": "arxivjs.summarizePaper",
        "title": "Generate Summary",
        "category": "ArxivJS",
        "icon": "$(sparkle)"
      },
      {
        "command": "arxivjs.summarizeTopic",
        "title": "Summarize All Papers Without Summaries",
        "category": "ArxivJS",
        "icon": "$(sparkle)"
      },
      {
        "command": "arxivjs.setGeminiApiKey",
        "title": "Set Gemini API Key",
        "category": "ArxivJS",
        "icon": "$(key)"
      },
      {
        "command": "arxivjs.clearGeminiApiKey",
        "title": "Delete Gemini API Key",
        "category": "ArxivJS",
        "icon": "$(key)"
      },
      {
        "command": "arxivjs.openHome",
        "title": "Open Topic List (Home)",
        "category": "ArxivJS",
        "icon": "$(home)"
      },
      {
        "command": "arxivjs.selectDataFolder",
        "title": "Select Data Folder",
        "category": "ArxivJS",
        "icon": "$(folder-opened)"
      },
      {
        "command": "arxivjs.reload",
        "title": "Reload",
        "category": "ArxivJS",
        "icon": "$(refresh)"
      },
      {
        "command": "arxivjs.reloadTopic",
        "title": "Reload Topic",
        "category": "ArxivJS",
        "icon": "$(refresh)"
      },
      {
        "command": "arxivjs.openSettings",
        "title": "Open Settings",
        "category": "ArxivJS",
        "icon": "$(gear)"
      },
      {
        "command": "arxivjs.openTopic",
        "title": "Open Topic",
        "category": "ArxivJS",
        "icon": "$(table)"
      },
      {
        "command": "arxivjs.openPaper",
        "title": "Open Paper",
        "category": "ArxivJS",
        "icon": "$(book)"
      },
      {
        "command": "arxivjs.reloadPaper",
        "title": "Reload Paper",
        "category": "ArxivJS",
        "icon": "$(refresh)"
      },
      {
        "command": "arxivjs.openExternal",
        "title": "Open Original URL",
        "category": "ArxivJS",
        "icon": "$(link-external)"
      },
      {
        "command": "arxivjs.copyCitationInfo",
        "title": "Copy Paper Info",
        "category": "ArxivJS",
        "icon": "$(copy)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "arxivjs.createTopic",
          "when": "view == arxivjs.topics && config.arxivjs.enableWrite",
          "group": "navigation@0"
        },
        {
          "command": "arxivjs.openHome",
          "when": "view == arxivjs.topics",
          "group": "navigation@1"
        },
        {
          "command": "arxivjs.reload",
          "when": "view == arxivjs.topics",
          "group": "navigation@2"
        },
        {
          "command": "arxivjs.selectDataFolder",
          "when": "view == arxivjs.topics",
          "group": "navigation@3"
        },
        {
          "command": "arxivjs.openSettings",
          "when": "view == arxivjs.topics",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "arxivjs.openTopic",
          "when": "view == arxivjs.topics && viewItem == arxivjs.topic",
          "group": "navigation@0"
        },
        {
          "command": "arxivjs.reloadTopic",
          "when": "view == arxivjs.topics && viewItem == arxivjs.topic",
          "group": "inline"
        },
        {
          "command": "arxivjs.reloadTopic",
          "when": "view == arxivjs.topics && viewItem == arxivjs.topic",
          "group": "navigation@1"
        },
        {
          "command": "arxivjs.addPaper",
          "when": "view == arxivjs.topics && viewItem == arxivjs.topic && config.arxivjs.enableWrite",
          "group": "2_edit@0"
        },
        {
          "command": "arxivjs.renameTopic",
          "when": "view == arxivjs.topics && viewItem == arxivjs.topic && config.arxivjs.enableWrite",
          "group": "2_edit@1"
        },
        {
          "command": "arxivjs.deleteTopic",
          "when": "view == arxivjs.topics && viewItem == arxivjs.topic && config.arxivjs.enableWrite",
          "group": "2_edit@2"
        },
        {
          "command": "arxivjs.openExternal",
          "when": "view == arxivjs.topics && viewItem =~ /^arxivjs.paper/",
          "group": "inline"
        },
        {
          "command": "arxivjs.openPaper",
          "when": "view == arxivjs.topics && viewItem =~ /^arxivjs.paper/",
          "group": "navigation@1"
        },
        {
          "command": "arxivjs.openExternal",
          "when": "view == arxivjs.topics && viewItem =~ /^arxivjs.paper/",
          "group": "navigation@2"
        },
        {
          "command": "arxivjs.copyCitationInfo",
          "when": "view == arxivjs.topics && viewItem =~ /^arxivjs.paper/",
          "group": "navigation@3"
        },
        {
          "command": "arxivjs.editPaperMeta",
          "when": "view == arxivjs.topics && viewItem =~ /^arxivjs.paper/ && config.arxivjs.enableWrite",
          "group": "2_edit@1"
        },
        {
          "command": "arxivjs.movePaper",
          "when": "view == arxivjs.topics && viewItem =~ /^arxivjs.paper/ && config.arxivjs.enableWrite",
          "group": "2_edit@2"
        },
        {
          "command": "arxivjs.deleteSummary",
          "when": "view == arxivjs.topics && viewItem == arxivjs.paper && config.arxivjs.enableWrite",
          "group": "2_edit@3"
        },
        {
          "command": "arxivjs.deletePaper",
          "when": "view == arxivjs.topics && viewItem =~ /^arxivjs.paper/ && config.arxivjs.enableWrite",
          "group": "2_edit@4"
        },
        {
          "command": "arxivjs.summarizeTopic",
          "when": "view == arxivjs.topics && viewItem == arxivjs.topic && config.arxivjs.enableWrite",
          "group": "1_summary@0"
        },
        {
          "command": "arxivjs.summarizePaper",
          "when": "view == arxivjs.topics && viewItem =~ /^arxivjs.paper/ && config.arxivjs.enableWrite",
          "group": "1_summary@0"
        }
      ],
      "commandPalette": [
        {
          "command": "arxivjs.createTopic",
          "when": "config.arxivjs.enableWrite"
        },
        {
          "command": "arxivjs.renameTopic",
          "when": "config.arxivjs.enableWrite"
        },
        {
          "command": "arxivjs.deleteTopic",
          "when": "config.arxivjs.enableWrite"
        },
        {
          "command": "arxivjs.addPaper",
          "when": "config.arxivjs.enableWrite"
        },
        {
          "command": "arxivjs.editPaperMeta",
          "when": "config.arxivjs.enableWrite"
        },
        {
          "command": "arxivjs.movePaper",
          "when": "config.arxivjs.enableWrite"
        },
        {
          "command": "arxivjs.deletePaper",
          "when": "config.arxivjs.enableWrite"
        },
        {
          "command": "arxivjs.deleteSummary",
          "when": "config.arxivjs.enableWrite"
        },
        {
          "command": "arxivjs.summarizePaper",
          "when": "config.arxivjs.enableWrite"
        },
        {
          "command": "arxivjs.summarizeTopic",
          "when": "config.arxivjs.enableWrite"
        },
        {
          "command": "arxivjs.reloadTopic",
          "when": "false"
        },
        {
          "command": "arxivjs.reloadPaper",
          "when": "activeWebviewPanelId == 'arxivjs.paper'"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:integration": "node esbuild.mjs && tsc -p test/integration",
    "test:integration": "node scripts/run-integration.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production",
    "bench": "esbuild scripts/bench.ts --bundle --platform=node --outfile=out/bench.js --log-level=warning && node out/bench.js",
    "icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "katex": "^0.18.11",
    "markdown-it": "^15.0.2",
    "unpdf": "1.8.1"
  },
  "overrides": {
    "@vscode/markdown-it-katex": {
      "katex": "$katex"
    }
  }
}
